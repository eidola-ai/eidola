<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>Eidola</string>
	<!--
		The bundle identifier, and with it the app's permanent identity to
		macOS: TCC grants, LaunchServices registration, the Developer ID App
		ID, and `SMAppService` all key off this string. Convention:
		`ai.eidola.<product>.<target>` — lowercase forever, Apple's
		target-family names, and `app` is the flagship product slot. A child
		process or login item appends a role (`ai.eidola.app.macos.launcher`);
		none exist today. Changing it orphans every grant a user has made, so
		it changes only by a deliberate decision.
	-->
	<key>CFBundleIdentifier</key>
	<string>ai.eidola.app.macos</string>
	<!--
		The app icon, resolved as Contents/Resources/AppIcon.icns. Generated
		from the vector master by `just update-brand` — see brand/AGENTS.md.
	-->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Eidola</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!--
		Required for AppKit to treat the binary as a real app: without an
		Info.plist visible to the launched binary, NSApplication runs in a
		"tool" mode where menu key-equivalent dispatch is unreliable when no
		window is key (post ⌘Tab back, after closing the last window). The
		bundle name showing as "eidola-gui" in the menu bar is the diagnostic
		signal that the binary is running tool-mode.
	-->
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!--
		The product floor. 13.0 (Ventura) is what `SMAppService` needs — the
		"Open at login" toggle (crates/eidola-gui/src/login_item.rs) is
		otherwise a feature that can only report Unavailable, and a floor
		LaunchServices enforces is more honest than shipping to a system
		where part of the app cannot work. Note this is the *bundle's*
		declared floor: the binaries still carry `LC_BUILD_VERSION minos
		11.0`, so a bare (unbundled) binary is not covered by it. See the
		guard comment in `login_item.rs`.
	-->
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<!--
		Don't auto-quit when the last window closes; the app stays alive and
		can be reopened via the dock icon (see `Application::on_reopen` in
		crates/eidola-gui/src/lib.rs).
	-->
	<key>LSUIElement</key>
	<false/>
	<!--
		High-DPI / Retina rendering. Required so Metal-rendered content
		matches the screen's backing scale instead of looking pixel-doubled.
	-->
	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
