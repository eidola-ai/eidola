{
  "archs": ["sm_100a", "sm_103a", "sm_100f"],
  "fatbin_archs": ["sm_100a", "sm_103a"],
  "common_flags": ["-cubin", "-DNDEBUG"],
  "profiles": {
    "own": {
      "flags": ["-std=c++17", "-O3"],
      "includes": []
    },
    "cutlass": {
      "flags": ["-std=c++17", "-O3", "--expt-relaxed-constexpr"],
      "includes": ["cutlass/include"]
    },
    "deepgemm": {
      "flags": [
        "-std=c++20",
        "-O3",
        "--expt-relaxed-constexpr",
        "--expt-extended-lambda",
        "--ptxas-options=--register-usage-level=10"
      ],
      "includes": ["cutlass/include", "deepgemm/deep_gemm/include"]
    },
    "flashinfer": {
      "flags": [
        "-std=c++17",
        "-O3",
        "-use_fast_math",
        "--expt-relaxed-constexpr",
        "-DFLASHINFER_ENABLE_F16",
        "-DFLASHINFER_ENABLE_BF16",
        "-DFLASHINFER_ENABLE_FP8_E4M3",
        "-DFLASHINFER_ENABLE_FP8_E5M2"
      ],
      "includes": ["flashinfer/include", "generated/flashinfer_sink"]
    }
  },
  "kernels": [
    { "name": "rmsnorm", "source": "rmsnorm.cu", "profile": "own" },
    { "name": "cutlass_fp8_blockwise_gemm", "source": "cutlass_fp8_blockwise_gemm.cu", "profile": "cutlass" },
    { "name": "deepgemm_fp8_fp4_grouped", "source": "deepgemm_fp8_fp4_grouped.cu", "profile": "deepgemm" },
    { "name": "flashinfer_fa2_sink_paged", "source": "flashinfer_fa2_sink_paged.cu", "profile": "flashinfer" },
    { "name": "flashinfer_sampling", "source": "flashinfer_sampling.cu", "profile": "flashinfer" }
  ]
}
