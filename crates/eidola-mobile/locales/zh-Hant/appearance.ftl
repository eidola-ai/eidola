# Appearance (Traditional Chinese). See the English source for what each message is.
appearance-title = 外觀
appearance-day-night = 晝夜
appearance-auto = 自動
appearance-system = 系統
appearance-day = 白天
appearance-night = 夜間
appearance-day-night-choice = 晝夜：{ $choice }
appearance-day-night-note = 「系統」跟隨手機的淺色或深色設定。「自動」按固定時鐘切換——06:00 至 18:00 為白天。
appearance-time-of-day = 時段
appearance-on = 開
appearance-off = 關
appearance-time-of-day-choice = 時段：{ $choice }
appearance-time-of-day-note = 跟隨一天中的光線——早晨偏冷，正午和午夜中性，傍晚偏暖——使用同一個固定時鐘。
appearance-light = 光線
appearance-light-cool = 冷
appearance-light-neutral = 中性
appearance-light-warm = 暖
appearance-light-choice = 光線：{ $choice }
appearance-light-note = 為配色指定固定的光線特徵。
appearance-text-size = 文字大小
appearance-text-smaller = 縮小文字，目前 { $percent }
appearance-text-larger = 放大文字，目前 { $percent }
appearance-text-reset = 重設
appearance-text-reset-name = 將文字大小重設為 100%
appearance-text-size-note = 縮放所有文字。
appearance-language = 語言
appearance-language-note = 如果 Eidola 支援你手機的語言，就會使用它：English、Español、Français、简体中文或繁體中文。
appearance-failed = 無法儲存：{ $reason }
