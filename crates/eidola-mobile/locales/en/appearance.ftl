# Appearance (src/ui/appearance.rs): the desktop's Settings ▸ General
# appearance axes that apply on a phone, in its words where they hold.

appearance-title = Appearance
appearance-day-night = Day & night
appearance-auto = Auto
appearance-system = System
appearance-day = Day
appearance-night = Night
# A choice's accessible name; $choice is one of the four labels above.
appearance-day-night-choice = Day & night: { $choice }
# Not the desktop's note: a webview cannot read where the sun is, so Auto
# follows a fixed clock here. Say so.
appearance-day-night-note = System follows your phone’s light or dark setting. Auto follows a fixed clock — day from 06:00 to 18:00.
appearance-time-of-day = Time of day
appearance-on = On
appearance-off = Off
appearance-time-of-day-choice = Time of day: { $choice }
appearance-time-of-day-note = Follows the light of the day — cool in the morning, neutral midday and midnight, warm in the evening — on the same fixed clock.
appearance-light = Light
appearance-light-cool = Cool
appearance-light-neutral = Neutral
appearance-light-warm = Warm
appearance-light-choice = Light: { $choice }
appearance-light-note = A fixed light character for the palette.
appearance-text-size = Text size
# $percent is the current scale, already formatted ("100%").
appearance-text-smaller = Smaller text, currently { $percent }
appearance-text-larger = Larger text, currently { $percent }
appearance-text-reset = Reset
appearance-text-reset-name = Reset text size to 100%
appearance-text-size-note = Scales all text.
appearance-language = Language
appearance-language-note = Eidola speaks your phone’s language when it has it: English, Español, Français, 简体中文 or 繁體中文.
appearance-failed = Couldn’t save that: { $reason }
