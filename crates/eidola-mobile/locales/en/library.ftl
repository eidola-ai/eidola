# The Library: the phone's list of conversations (src/ui/library.rs).

# The screen's heading.
library-title = Conversations
# The button that starts a new conversation (its accessible name).
library-new = New conversation
# Shown when there are no conversations yet.
library-empty = No conversations yet.
# The call to action beneath the empty state.
library-empty-start = Start a conversation
# A conversation that has no title and no first message yet.
library-untitled = Untitled conversation
# A row's accessible name: its title and when it was last active.
library-row-label = { $title }, { $when }
# The first load of the list failed.
library-load-failed = Couldn’t load your conversations.
# A refresh failed over a list that is still shown.
library-refresh-failed = Couldn’t refresh — retry
# Retry a failed load.
library-retry = Retry
# The button that opens Settings (its accessible name).
library-settings = Settings
