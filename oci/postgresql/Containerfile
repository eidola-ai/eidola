# syntax=docker/dockerfile:1@sha256:a7f5ec8c4a35a7f8cd9e6e413f59fd1bfd33f8b623c26981c684f5065dfe3044

# ── base ───────────────────────────────────────────────────────────────────────
# Pin digests for all StageX package dependencies.

FROM stagex/user-postgresql:sx2026.09.0@sha256:43f217e842b6dc692698b1f364dd944d4a3d032fd5dfedcf9ec654adc7916885 AS pkg-postgresql
FROM stagex/core-busybox:sx2026.09.0@sha256:68af02a86c6b9fc7dc439c021fd33bd87d93acaa4fee528d0bfd0d7d6fdd2d57 AS pkg-busybox
FROM stagex/core-musl:sx2026.09.0@sha256:0c2991ec4914f7c3600adeac9983fa788bc22cae4b56989d8d68c2992d7bfdcf AS pkg-musl
FROM stagex/core-zlib:sx2026.09.0@sha256:4e04df81afff7711584c59f3d8c44d8fda5887378fc972e910f871330337db90 AS pkg-zlib
FROM stagex/core-openssl:sx2026.09.0@sha256:f97827b11a98c010113e0d6acc464c77cbf6ea47a67867cfd1baff093bc5399a AS pkg-openssl
FROM stagex/core-libcxx:sx2026.09.0@sha256:c788849ba7091503bed8b829b262c40e0fddb5757a765d812be8b439137aee11 AS pkg-libcxx
FROM stagex/core-libcxxabi:sx2026.09.0@sha256:37cb5b3da0a1683e7257d80b4228fe4a004cb31bffd8ecd052d7863ef2b1758f AS pkg-libcxxabi
FROM stagex/core-libunwind:sx2026.09.0@sha256:50b14a6adb98c989c8e59ac52e8ad1d3aa125083ecba25fffe94b2541152a1ca AS pkg-libunwind
FROM stagex/core-icu:sx2026.09.0@sha256:0808e1e1a049afabbf5cf783b458a08b8e682e9efb23c28c4ee64c3febbb80f2 AS pkg-icu
FROM stagex/core-ncurses:sx2026.09.0@sha256:a5875ef06637624ead593724c43ab27be5fc7dbec5d292022bfe234896f584c1 AS pkg-ncurses
FROM stagex/core-readline:sx2026.09.0@sha256:f3baf228b87e7adb5d5ff60625daa4dedbfd4e667d8fdf2a8130cca799d31600 AS pkg-readline
FROM stagex/core-libxml2:sx2026.09.0@sha256:764791bad311082a104d9252889fc9b2f32872af7b29d8371a5d3c06e0bb0ce3 AS pkg-libxml2

# ── fetch ──────────────────────────────────────────────────────────────────────
# (no-op: all dependencies are pre-built StageX packages pinned above)

# ── build ──────────────────────────────────────────────────────────────────────
# (no-op: using pre-built packages, no compilation needed)

# ── install ────────────────────────────────────────────────────────────────────
# Assemble filesystem from StageX packages (COPY only, no RUN needed).

FROM scratch AS install

COPY --from=pkg-busybox . /
COPY --from=pkg-musl . /
COPY --from=pkg-zlib . /
COPY --from=pkg-openssl . /
COPY --from=pkg-libcxx . /
COPY --from=pkg-libcxxabi . /
COPY --from=pkg-libunwind . /
COPY --from=pkg-icu . /
COPY --from=pkg-ncurses . /
COPY --from=pkg-readline . /
COPY --from=pkg-libxml2 . /
COPY --from=pkg-postgresql . /
COPY --chmod=755 oci/postgresql/entrypoint.sh /entrypoint.sh

# ── dirs ──────────────────────────────────────────────────────────────────────
# Create runtime directories owned by uid 1000 using a disposable stage.
# We COPY the resulting directory tree into the final image instead of using
# RUN, because RUN layers capture the full overlayfs diff which can include
# host-specific artifacts (e.g. Rosetta translation caches on Docker Desktop)
# that break cross-environment reproducibility.

FROM install AS dirs

RUN --network=none mkdir -p /dirs/var/lib/postgresql/data /dirs/run/postgresql /dirs/docker-entrypoint-initdb.d && \
    chown -R 1000:1000 /dirs

# ── package ────────────────────────────────────────────────────────────────────

FROM scratch AS package

COPY --from=install / /
COPY --from=dirs /dirs/ /

# StageX core-readline is missing a DT_NEEDED for ncurses, so termcap symbols
# (tputs, tgetent, etc.) aren't found by the dynamic linker.
ENV LD_PRELOAD=/lib/libncursesw.so.6
ENV PGDATA=/var/lib/postgresql/data
EXPOSE 5432
USER 1000:1000
ENTRYPOINT ["/entrypoint.sh"]
