# Machine-local environment (not committed): toolchain/sysroot wiring that
# only applies to one box, e.g. PKG_CONFIG paths for building the GUI's C
# deps without system-wide dev headers.
source_env_if_exists .envrc.local

# Build the pinned Rust-based dev tools (their own workspace, crates/devtools)
# and put them on PATH. This is the only thing standing between a `cargo` +
# `direnv` checkout and a working dev environment — `just`, `rumdl`, etc.
# come from here, so no separate `brew install just` is needed. The
# workspace's own debug binaries stay on PATH too; the tools are added last
# so they take precedence.
cargo build --quiet --manifest-path crates/devtools/Cargo.toml -p rumdl -p just -p cargo-deny
PATH_add target/debug
PATH_add crates/devtools/target/debug
